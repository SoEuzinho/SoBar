<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="SoBar" Manufacturer="SoBar" Version="$(var.Version)" Language="1046"
           UpgradeCode="28F56D0E-874B-48B7-AFBA-F148F7B583AE" Scope="perUser" InstallerVersion="500" Compressed="yes">
    <MajorUpgrade Schedule="afterInstallExecute" DowngradeErrorMessage="Uma versão mais recente do SoBar já está instalada." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs"><Directory Id="INSTALLFOLDER" Name="SoBar" /></Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenu" Guid="B4A52D4F-D5DA-4BAF-A9C6-92EE7F0C7747">
        <Shortcut Id="SoBarMenu" Name="SoBar" Target="[INSTALLFOLDER]SoBar.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\SoBar\Installer" Name="Shortcut" Value="1" Type="integer" KeyPath="yes"/>
        <RemoveFile Id="CleanStartup" Directory="StartupFolder" Name="SoBar AutoStart.lnk" On="uninstall" />
      </Component>
    </StandardDirectory>
    <StandardDirectory Id="StartupFolder"/>
    <Feature Id="Application" Title="SoBar" Level="1"><ComponentGroupRef Id="Payload"/><ComponentRef Id="StartMenu"/></Feature>
  </Package>
</Wix>
