<Window x:Class="SoBar.App.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 WindowStartupLocation="CenterScreen" Style="{StaticResource PanelWindow}" Title="Configurações • SoBar" Width="794" Height="600" MinWidth="345">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Padding="21,14" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Line}">
      <DockPanel><StackPanel Orientation="Horizontal"><TextBlock Text="◒" FontSize="27" Foreground="{DynamicResource Accent}"/>
        <TextBlock Text="SoBar" FontWeight="SemiBold" FontSize="24" Margin="8,0,12,0"/><TextBlock Text="Configurações" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
      </StackPanel><Button Content="Encerrar" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ExitClick"/></DockPanel>
    </Border>
    <Grid Grid.Row="1" x:Name="Body"><Grid.ColumnDefinitions><ColumnDefinition Width="157" x:Name="NavColumn"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Background="{DynamicResource Surface}" Padding="9,14,6,0">
        <StackPanel x:Name="Nav"/>
      </Border>
      <ScrollViewer Grid.Column="1" x:Name="Scroll" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Page" Margin="21,14,22,22"/>
      </ScrollViewer>
    </Grid>
    <Border Grid.Row="2" Padding="14,8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Line}">
      <TextBlock x:Name="Status" Text="Saída de emergência • Ctrl+Alt+Shift+End" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
    </Border>
  </Grid>
</Window>
